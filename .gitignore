# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - jamais commites, aucune exception
.env
.env.*
*.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Defense en profondeur sur les secrets ---
# Un secret pousse une fois reste dans l'historique meme apres suppression.
# Ces motifs attrapent les fichiers et les artefacts qui en portent d'habitude.
*secret*
*.token
*.pem
*.key
*.p12
*.keystore
*.jks
credentials.json
service-account*.json
# Prefixes de jetons des services utilises ici
ghp_*
github_pat_*
sbp_*
sb_secret_*
re_*
sk_live_*
rk_live_*
# Scripts jetables qui portent souvent un jeton en dur
scripts/*.local.mjs
scripts/*.local.py
scripts/*.local.sh

# Sorties de travail
/playwright-report/
/test-results/
/screenshots/
# Journaux et instantanes laisses par le pilotage de navigateur
.playwright-mcp/
*.local

# Outils d'agents
.claude/
.aider*
# Config MCP : porte des cles API en clair (x-api-key), ne doit jamais partir
# dans un depot public.
.mcp.json
mcp.json
21st_sk_*
.env*

# Bytecode Python, genere a l execution des scripts de garde.
__pycache__/
*.pyc
preuves/
